generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id                      String   @id @default(cuid())
  nombre                  String
  tiendanube_access_token String
  tiendanube_store_id     String
  whatsapp_api_token      String
  is_active               Boolean  @default(true)
  marketing_spend         Float    @default(0)
  createdAt               DateTime @default(now())

  customers     Customer[]
  campaigns     Campaign[]
  coupons       Coupon[]
  messageLogs   MessageLog[]
  gclidSessions GclidSession[]
  reviews       Review[]
  visitors      Visitor[]
  widgets       Widget[]
}

model Customer {
  id                     String   @id @default(cuid())
  store_id               String
  tiendanube_customer_id String
  nombre                 String
  telefono               String
  total_spent            Float    @default(0)
  createdAt              DateTime @default(now())

  store       Store        @relation(fields: [store_id], references: [id])
  coupons     Coupon[]
  messageLogs MessageLog[]
  reviews     Review[]

  @@unique([store_id, tiendanube_customer_id])
}

model Campaign {
  id            String       @id @default(cuid())
  store_id      String
  tipo          CampaignType
  configuracion Json
  is_active     Boolean      @default(true)
  createdAt     DateTime     @default(now())

  store       Store        @relation(fields: [store_id], references: [id])
  coupons     Coupon[]
  messageLogs MessageLog[]
}

model Coupon {
  id          String   @id @default(cuid())
  store_id    String
  codigo      String   @unique
  customer_id String
  campaign_id String
  is_used     Boolean  @default(false)
  createdAt   DateTime @default(now())

  store    Store    @relation(fields: [store_id], references: [id])
  customer Customer @relation(fields: [customer_id], references: [id])
  campaign Campaign @relation(fields: [campaign_id], references: [id])
}

model MessageLog {
  id            String       @id @default(cuid())
  store_id      String
  customer_id   String
  campaign_id   String
  estado        MessageState @default(PENDING)
  tipo_evento   String
  error_details String?
  scheduled_for DateTime?
  createdAt     DateTime     @default(now())

  store    Store    @relation(fields: [store_id], references: [id])
  customer Customer @relation(fields: [customer_id], references: [id])
  campaign Campaign @relation(fields: [campaign_id], references: [id])

  // Índices derivados de los patrones de consulta reales (ver la migración
  // 20260726150000_messagelog_indices). El nombre va explícito para que coincida con el SQL
  // escrito a mano y Prisma no lo marque como drift.
  @@index([store_id, customer_id, campaign_id, tipo_evento], map: "MessageLog_store_customer_campaign_tipo_idx")
  @@index([estado, scheduled_for], map: "MessageLog_estado_scheduled_idx")
  @@index([store_id, estado, createdAt], map: "MessageLog_store_estado_creado_idx")
  @@index([store_id, tipo_evento, createdAt], map: "MessageLog_store_tipo_creado_idx")
}

// Respuesta de un cliente tras la plantilla resena_post_entrega — capturada
// por el webhook de WhatsApp cuando contesta dentro de la ventana de espera.
model Review {
  id          String    @id @default(cuid())
  store_id    String
  customer_id String?
  autor       String?
  rating      Int?
  texto       String
  source         String    @default("whatsapp") // whatsapp | google | form
  approved       Boolean   @default(true)
  fecha          DateTime? // fecha real de la reseña (Google la trae; WhatsApp usa createdAt)
  external_id    String?   // id de la reseña en su fuente (Google) para no duplicar en cada sync
  product_id     String?   // id de producto de Tiendanube al que apunta la reseña
  product_nombre String?   // nombre del producto guardado al momento, para el panel
  foto_url       String?   // foto que sube el cliente con la reseña (Vercel Blob)
  createdAt      DateTime  @default(now())

  store    Store     @relation(fields: [store_id], references: [id])
  customer Customer? @relation(fields: [customer_id], references: [id])

  @@unique([source, external_id])
  @@index([store_id, approved, source])
  @@index([store_id, approved, product_id])
}

enum CampaignType {
  RECOVERY
  REFERRAL
  REFILL
  REVIEW
}

enum MessageState {
  PENDING
  SENT
  FAILED
}

model GadsCache {
  id              String   @id @default(cuid())
  date            String
  campaign_id     String
  campaign_name   String
  campaign_status String
  campaign_type   String
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost_ars        Float    @default(0)
  conversions     Float    @default(0)
  conv_value      Float    @default(0)
  ctr             Float    @default(0)
  avg_cpc         Float    @default(0)
  synced_at       DateTime @default(now())

  @@unique([date, campaign_id])
  @@map("gads_cache")
}

model GclidSession {
  id         String   @id @default(cuid())
  store_id   String
  gclid      String
  phone      String? // normalizado 549..., se rellena cuando el usuario compra
  order_id   String? // TN order ID, se rellena al hacer match
  uploaded   Boolean  @default(false)
  created_at DateTime @default(now())
  expires_at DateTime // 90 días desde la llegada (ventana de conversión de Google Ads)

  store Store @relation(fields: [store_id], references: [id])

  @@index([store_id, phone])
  @@index([store_id, gclid])
}

// ─────────────────────────────────────────────────────────────
// TRACKING DE CURIOSOS — identidad de primera parte + cohortes
// Separa el tráfico de campaña (Meta TOFU) del SEO/directo de Google,
// mide permanencia/curiosidad y sigue retorno + recompra en el tiempo.
// Misma taxonomía de canal que lib/attribution.ts (classifyOrder).
// ─────────────────────────────────────────────────────────────

model Visitor {
  id       String @id @default(cuid())
  store_id String
  vid      String // UUID de primera parte (cookie 2 años, generado en el browser)

  // FIRST TOUCH — sellado en la 1ra visita, NUNCA se sobreescribe.
  // Esto es lo que hace confiable la atribución para decidir campañas.
  ft_channel  String // meta_ads | google_ads | seo | directo | otro_utm
  ft_source   String? // utm_source, o host del referrer (google/instagram/…)
  ft_campaign String? // utm_campaign si vino
  ft_landing  String? // primera landing (con query completa)
  ft_at       DateTime @default(now())

  // COSIDO A COMPRA — se rellena cuando el visitante llega al thank-you page.
  email        String?
  order_number Int?
  purchased_at DateTime?

  last_seen DateTime @default(now())

  store  Store   @relation(fields: [store_id], references: [id])
  visits Visit[]

  @@unique([store_id, vid])
  @@index([store_id, ft_channel])
  @@index([store_id, ft_at])
}

model Visit {
  id         String @id @default(cuid())
  visitor_id String // FK a Visitor.id

  started_at     DateTime @default(now())
  duration_ms    Int      @default(0)
  max_scroll     Int      @default(0) // % máximo de scroll (0-100)
  pageviews      Int      @default(1)
  viewed_product Boolean  @default(false)
  engaged        Boolean  @default(false) // dur≥10s ó scroll≥50% ó vio producto

  channel String // canal de ESTA visita (puede diferir del first touch)
  landing String?

  visitor Visitor @relation(fields: [visitor_id], references: [id])

  @@index([visitor_id])
  @@index([started_at])
}

// Contadores de rate limiting (ventana fija). Una fila por clave activa; las vencidas se
// borran de forma oportunista desde lib/ratelimit.ts, sin cron dedicado.
model RateLimit {
  key            String   @id
  ventana_inicio DateTime @default(now())
  contador       Int      @default(0)

  @@index([ventana_inicio])
}

// ─────────────────────────────────────────────────────────────────────────────
// MOTOR DE WIDGETS
//
// Un widget es SOLO datos: tipo + config JSON. El código no sabe qué dice un widget,
// solo cómo dibujar cada tipo (lib/widgets/tipos.ts declara los campos, public/mic.js
// los renderiza). Cambiar un texto, prender o apagar algo se hace desde /dashboard/widgets
// sin tocar código ni desplegar. Esa es toda la razón de ser de estas tablas.

model Widget {
  id       String @id @default(cuid())
  store_id String

  tipo     String  // slug del tipo, ver lib/widgets/tipos.ts
  nombre   String  // etiqueta interna, para reconocerlo en la lista del panel
  contexto String  // guias | tienda | producto
  config   Json    // valores de los campos declarados por el tipo
  reglas   Json?   // dónde/cuándo aparece: rutas, dispositivo, ventana de fechas

  activo Boolean @default(false) // nace apagado: nada sale a producción sin un clic explícito
  orden  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store         @relation(fields: [store_id], references: [id])
  events WidgetEvent[]

  @@index([store_id, contexto, activo])
}

model WidgetEvent {
  id        String   @id @default(cuid())
  widget_id String
  tipo      String   // impresion | interaccion | conversion
  vid       String?  // visitante de primera parte, para cruzar con Visitor
  meta      Json?
  createdAt DateTime @default(now())

  widget Widget @relation(fields: [widget_id], references: [id], onDelete: Cascade)

  @@index([widget_id, tipo, createdAt])
}

model WidgetLead {
  id        String   @id @default(cuid())
  widget_id String
  email     String
  dato      Json?    // lo que pidiera el widget además del email
  createdAt DateTime @default(now())

  @@unique([widget_id, email])
  @@index([createdAt])
}

/// Latido de procesos externos (el VPS de ventas apícola). Si deja de latir,
/// el cron de Vercel avisa: la ausencia de avisos deja de ser indistinguible
/// de "no hubo ventas".
model Heartbeat {
  nombre    String   @id
  ts        DateTime @default(now())
  meta      Json?
  alertado  DateTime?
}

/// Estado de entrega REAL de los mensajes de WhatsApp (webhook `statuses`).
/// La Cloud API devuelve wamid aunque después el mensaje falle (131047 fuera
/// de ventana): sin esto, "enviado" no significa "llegó".
model WaStatus {
  wamid       String   @id
  estado      String   // sent | delivered | read | failed
  destino     String?
  error_code  Int?
  error_desc  String?
  ts          DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estado, ts])
}

/// Espejo en Postgres de los envíos apícolas que el VPS lleva en SQLite. Existe para
/// que el panel pueda mostrarlos: el VPS no es alcanzable desde Vercel (vive detrás de
/// Tailscale), así que empuja su estado en cada ciclo.
model EnvioApicola {
  interno         Int       @id
  shipment_id     String
  ml_order_id     String
  fecha_compra    DateTime
  cliente         String
  items           String
  unidades        Int       @default(1)
  estado          String    // label_ok | sent | wa_fallido | label_timeout | pendiente
  wamid           String?
  wa_entregado    Boolean   @default(false)
  wa_leido        Boolean   @default(false)   // el tío además lo abrió (si tiene los acuses de lectura activos)
  wa_intentos     Int       @default(0)
  wa_detalle      String?   // motivo cuando no se entregó
  enviado_at      DateTime?
  despachado      Boolean   @default(false)
  avisos_tio      Int       @default(0)
  escalados       Int       @default(0)
  actualizado     DateTime  @updatedAt

  @@index([fecha_compra])
}
