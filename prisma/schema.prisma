generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id                      String   @id @default(cuid())
  nombre                  String
  tiendanube_access_token String
  tiendanube_store_id     String
  whatsapp_api_token      String
  is_active               Boolean  @default(true)
  marketing_spend         Float    @default(0)
  createdAt               DateTime @default(now())

  customers     Customer[]
  campaigns     Campaign[]
  coupons       Coupon[]
  messageLogs   MessageLog[]
  gclidSessions GclidSession[]
  reviews       Review[]
  visitors      Visitor[]
  widgets       Widget[]
}

model Customer {
  id                     String   @id @default(cuid())
  store_id               String
  tiendanube_customer_id String
  nombre                 String
  telefono               String
  total_spent            Float    @default(0)
  createdAt              DateTime @default(now())

  store       Store        @relation(fields: [store_id], references: [id])
  coupons     Coupon[]
  messageLogs MessageLog[]
  reviews     Review[]

  @@unique([store_id, tiendanube_customer_id])
}

model Campaign {
  id            String       @id @default(cuid())
  store_id      String
  tipo          CampaignType
  configuracion Json
  is_active     Boolean      @default(true)
  createdAt     DateTime     @default(now())

  store       Store        @relation(fields: [store_id], references: [id])
  coupons     Coupon[]
  messageLogs MessageLog[]
}

model Coupon {
  id          String   @id @default(cuid())
  store_id    String
  codigo      String
  customer_id String
  campaign_id String
  is_used     Boolean  @default(false)
  createdAt   DateTime @default(now())

  store    Store    @relation(fields: [store_id], references: [id])
  customer Customer @relation(fields: [customer_id], references: [id])
  campaign Campaign @relation(fields: [campaign_id], references: [id])

  // Único POR TIENDA, no global: con dos tiendas, la primera en emitir "BIENVENIDA10" le
  // bloqueaba ese código a la otra. Ver la migración 20260727140000_integridad_esquema.
  @@unique([store_id, codigo], map: "Coupon_store_codigo_key")
}

model MessageLog {
  id            String       @id @default(cuid())
  store_id      String
  customer_id   String
  campaign_id   String
  estado        MessageState @default(PENDING)
  tipo_evento   String
  // OJO: error_details carga dos significados todavía — el mensaje de error real, y una
  // marca de idempotencia ('order:<id>') que CampaignService consulta con `contains`.
  // El payload de la cola SALIÓ de acá a `payload` (migración 20260727150000_cola_envios);
  // separar la marca es un cambio aparte.
  error_details String?
  scheduled_for DateTime?
  createdAt     DateTime     @default(now())
  /// Identificador del mensaje que devuelve la Cloud API al aceptarlo. Es la llave contra
  /// WaStatus, la única forma de saber si el mensaje LLEGÓ y no solo si Meta lo aceptó: el
  /// error 131047 (fuera de la ventana de 24 h) responde 200 y no entrega.
  /// Va en columna propia y NO adentro de `payload`: ese campo ya significa "lo que hay que
  /// enviar" para la cola, y meterle un segundo sentido repite el problema de `error_details`.
  wamid         String?

  // ── Andamiaje de la cola (solo lo usan las filas de trabajo pendiente) ──
  /// Lo que hay que enviar: { message, phone }. Antes viajaba serializado en error_details.
  payload         Json?
  /// Intentos de envío. Con tope, para que un fallo permanente no reintente para siempre.
  intentos        Int       @default(0)
  /// Fila tomada por una corrida hasta esta hora. Es lo que impide el doble envío cuando
  /// dos ejecuciones del cron se solapan, y hace de backoff tras un fallo.
  bloqueado_hasta DateTime?

  store    Store    @relation(fields: [store_id], references: [id])
  customer Customer @relation(fields: [customer_id], references: [id])
  campaign Campaign @relation(fields: [campaign_id], references: [id])

  // Índices derivados de los patrones de consulta reales (ver la migración
  // 20260726150000_messagelog_indices). El nombre va explícito para que coincida con el SQL
  // escrito a mano y Prisma no lo marque como drift.
  @@index([store_id, customer_id, campaign_id, tipo_evento], map: "MessageLog_store_customer_campaign_tipo_idx")
  @@index([estado, scheduled_for], map: "MessageLog_estado_scheduled_idx")
  @@index([store_id, estado, createdAt], map: "MessageLog_store_estado_creado_idx")
  @@index([store_id, tipo_evento, createdAt], map: "MessageLog_store_tipo_creado_idx")
  // El acceso del consumidor de la cola: estado + programación + bloqueo.
  @@index([estado, scheduled_for, bloqueado_hasta], map: "MessageLog_cola_idx")
}

// Respuesta de un cliente tras la plantilla resena_post_entrega — capturada
// por el webhook de WhatsApp cuando contesta dentro de la ventana de espera.
model Review {
  id             String    @id @default(cuid())
  store_id       String
  customer_id    String?
  autor          String?
  rating         Int?
  texto          String
  source         String    @default("whatsapp") // whatsapp | google | form
  approved       Boolean   @default(false)
  fecha          DateTime? // fecha real de la reseña (Google la trae; WhatsApp usa createdAt)
  external_id    String? // id de la reseña en su fuente (Google) para no duplicar en cada sync
  product_id     String? // id de producto de Tiendanube al que apunta la reseña
  product_nombre String? // nombre del producto guardado al momento, para el panel
  foto_url       String? // foto que sube el cliente con la reseña (Vercel Blob)
  createdAt      DateTime  @default(now())

  store    Store     @relation(fields: [store_id], references: [id])
  customer Customer? @relation(fields: [customer_id], references: [id])

  @@unique([source, external_id])
  @@index([store_id, approved, source])
  @@index([store_id, approved, product_id])
}

enum CampaignType {
  RECOVERY
  REFERRAL
  REFILL
  REVIEW
}

enum MessageState {
  PENDING
  SENT
  FAILED
}

model GadsCache {
  id              String   @id @default(cuid())
  // Nullable a propósito: las filas anteriores a la migración
  // 20260727140000_integridad_esquema no tienen tienda asignada salvo que hubiera una sola.
  store_id        String?
  date            String
  campaign_id     String
  campaign_name   String
  campaign_status String
  campaign_type   String
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost_ars        Float    @default(0)
  conversions     Float    @default(0)
  conv_value      Float    @default(0)
  ctr             Float    @default(0)
  avg_cpc         Float    @default(0)
  synced_at       DateTime @default(now())

  @@unique([date, campaign_id])
  @@index([store_id, date], map: "gads_cache_store_date_idx")
  @@map("gads_cache")
}

model GclidSession {
  id         String   @id @default(cuid())
  store_id   String
  gclid      String
  phone      String? // normalizado 549..., se rellena cuando el usuario compra
  order_id   String? // TN order ID, se rellena al hacer match
  uploaded   Boolean  @default(false)
  created_at DateTime @default(now())
  expires_at DateTime // 90 días desde la llegada (ventana de conversión de Google Ads)

  store Store @relation(fields: [store_id], references: [id])

  @@index([store_id, phone])
  @@index([store_id, gclid])
}

// ─────────────────────────────────────────────────────────────
// TRACKING DE CURIOSOS — identidad de primera parte + cohortes
// Separa el tráfico de campaña (Meta TOFU) del SEO/directo de Google,
// mide permanencia/curiosidad y sigue retorno + recompra en el tiempo.
// Misma taxonomía de canal que lib/attribution.ts (classifyOrder).
// ─────────────────────────────────────────────────────────────

model Visitor {
  id       String @id @default(cuid())
  store_id String
  vid      String // UUID de primera parte (cookie 2 años, generado en el browser)

  // FIRST TOUCH — sellado en la 1ra visita, NUNCA se sobreescribe.
  // Esto es lo que hace confiable la atribución para decidir campañas.
  ft_channel  String // meta_ads | google_ads | seo | directo | otro_utm
  ft_source   String? // utm_source, o host del referrer (google/instagram/…)
  ft_campaign String? // utm_campaign si vino
  ft_landing  String? // primera landing (con query completa)
  ft_at       DateTime @default(now())

  // COSIDO A COMPRA — lo sella curiosos_cosido.py cruzando órdenes pagadas de TN.
  email        String?
  order_number Int?
  purchased_at DateTime?
  total_orden  Decimal?  @db.Decimal(10, 2) // total de la orden (API TN ya lo trae, antes se descartaba)

  last_seen DateTime @default(now())

  store  Store   @relation(fields: [store_id], references: [id])
  visits Visit[]

  @@unique([store_id, vid])
  @@index([store_id, ft_channel])
  @@index([store_id, ft_at])
  // El cosido de compras busca por email en cada corrida del cron: sin este índice es un
  // scan de la tabla que más rápido crece del proyecto.
  @@index([store_id, email], map: "Visitor_store_email_idx")
}

model Visit {
  id         String @id @default(cuid())
  visitor_id String // FK a Visitor.id

  started_at     DateTime @default(now())
  duration_ms    Int      @default(0)
  max_scroll     Int      @default(0) // % máximo de scroll (0-100)
  pageviews      Int      @default(1)
  viewed_product Boolean  @default(false)
  engaged        Boolean  @default(false) // dur≥10s ó scroll≥50% ó vio producto

  channel String // canal de ESTA visita (puede diferir del first touch)
  landing String?

  visitor Visitor @relation(fields: [visitor_id], references: [id])

  @@index([visitor_id])
  @@index([started_at])
}

// Contadores de rate limiting (ventana fija). Una fila por clave activa; las vencidas se
// borran de forma oportunista desde lib/ratelimit.ts, sin cron dedicado.
model RateLimit {
  key            String   @id
  ventana_inicio DateTime @default(now())
  contador       Int      @default(0)

  @@index([ventana_inicio])
}

// ─────────────────────────────────────────────────────────────────────────────
// MOTOR DE WIDGETS
//
// Un widget es SOLO datos: tipo + config JSON. El código no sabe qué dice un widget,
// solo cómo dibujar cada tipo (lib/widgets/tipos.ts declara los campos, public/mic.js
// los renderiza). Cambiar un texto, prender o apagar algo se hace desde /dashboard/widgets
// sin tocar código ni desplegar. Esa es toda la razón de ser de estas tablas.

model Widget {
  id       String @id @default(cuid())
  store_id String

  tipo     String // slug del tipo, ver lib/widgets/tipos.ts
  nombre   String // etiqueta interna, para reconocerlo en la lista del panel
  contexto String // guias | tienda | producto
  config   Json // valores de los campos declarados por el tipo
  reglas   Json? // dónde/cuándo aparece: rutas, dispositivo, ventana de fechas

  activo Boolean @default(false) // nace apagado: nada sale a producción sin un clic explícito
  orden  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store         @relation(fields: [store_id], references: [id])
  events WidgetEvent[]
  leads  WidgetLead[]

  @@index([store_id, contexto, activo])
}

model WidgetEvent {
  id        String   @id @default(cuid())
  widget_id String
  tipo      String // impresion | interaccion | conversion
  vid       String? // visitante de primera parte, para cruzar con Visitor
  meta      Json?
  createdAt DateTime @default(now())

  widget Widget @relation(fields: [widget_id], references: [id], onDelete: Cascade)

  @@index([widget_id, tipo, createdAt])
}

model WidgetLead {
  id        String   @id @default(cuid())
  widget_id String
  email     String
  dato      Json? // lo que pidiera el widget además del email
  createdAt DateTime @default(now())

  // Sin esta relación no había clave foránea: borrar un widget dejaba sus leads —emails de
  // gente real— colgando de un id inexistente, invisibles desde el panel.
  // Ver la migración 20260727140000_integridad_esquema.
  widget Widget @relation(fields: [widget_id], references: [id], onDelete: Cascade)

  @@unique([widget_id, email])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Una fila por CORRIDA de una automatización. Reemplaza a `CronHeartbeat`, que guardaba
// una sola fila por job (un upsert): servía para "¿corrió?" y para nada más.
//
// POR QUÉ APPEND-ONLY Y NO UN UPSERT
//
// Con una fila por job no se puede responder ninguna de las preguntas que importan cuando
// algo se rompe: ¿falla siempre o fue una vez?, ¿desde cuándo?, ¿está tardando más que
// antes? El upsert pisa justamente la evidencia que hace falta para diagnosticar. El costo
// es que la tabla crece — se poda a los 90 días desde la auditoría diaria.
//
// `ok` es redundante con `exit_code` a propósito: los jobs de Vercel y GitHub no tienen
// exit code (son HTTP), y los del VPS sí. Una sola columna booleana permite preguntar por
// el estado sin ramificar por origen en cada consulta.
//
// NOTA: sigue existiendo `Heartbeat` (abajo), del VPS apícola. Hace lo mismo con otro
// nombre. No se migró junto con este porque su panel es código recién salido y romperlo
// no vale el ahorro. Cuando se migre, `Heartbeat` desaparece y este queda como el único.
// Mientras tanto: NO agregar un tercer modelo de latido.
model JobRun {
  id          String    @id @default(cuid())
  slug        String // identificador del job: 'send-pending', 'crm_cron', ...
  origen      String // vercel | vps | github | windows
  inicio      DateTime  @default(now())
  fin         DateTime?
  duracion_ms Int?
  exit_code   Int? // solo los del VPS/Windows; null en los HTTP
  ok          Boolean   @default(true)
  detalle     String? // últimas líneas de salida, o el error

  @@index([slug, inicio])
  @@index([inicio])
}

/// Latido de procesos externos (el VPS de ventas apícola). Si deja de latir,
/// el cron de Vercel avisa: la ausencia de avisos deja de ser indistinguible
/// de "no hubo ventas".
model Heartbeat {
  nombre   String    @id
  ts       DateTime  @default(now())
  meta     Json?
  alertado DateTime?
}

/// Envío ADICIONAL sobre un pedido de Tiendanube que ya tiene su propio tracking principal
/// (ej. se despachó un accesorio faltante por separado, o un cambio de garantía). TN modela
/// un único `shipping_tracking_number` por orden, así que este segundo envío no tiene forma
/// de vivir ahí sin pisar el tracking del envío principal — motor-whatsapp lo guarda acá y
/// mensajeSeguimiento() lo suma como línea aparte cuando el cliente pregunta por su pedido.
model EnvioExtra {
  id            String    @id @default(cuid())
  orden_numero  Int // número de orden de Tiendanube (Pedido.numero), no el ID interno
  motivo        String // qué es: "booster faltante", "cambio de cúpula por garantía", ...
  tracking      String // nº de seguimiento (Andreani u otro correo)
  esAndreani    Boolean   @default(true)
  despachado_at DateTime  @default(now())
  entregado     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([orden_numero])
}

/// Estado de entrega REAL de los mensajes de WhatsApp (webhook `statuses`).
/// La Cloud API devuelve wamid aunque después el mensaje falle (131047 fuera
/// de ventana): sin esto, "enviado" no significa "llegó".
model WaStatus {
  wamid      String   @id
  estado     String // sent | delivered | read | failed
  destino    String?
  error_code Int?
  error_desc String?
  ts         DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([estado, ts])
}

/// Espejo en Postgres de los envíos apícolas que el VPS lleva en SQLite. Existe para
/// que el panel pueda mostrarlos: el VPS no es alcanzable desde Vercel (vive detrás de
/// Tailscale), así que empuja su estado en cada ciclo.
model EnvioApicola {
  interno      Int       @id
  shipment_id  String
  ml_order_id  String
  fecha_compra DateTime
  cliente      String
  items        String
  unidades     Int       @default(1)
  estado       String // label_ok | sent | wa_fallido | label_timeout | pendiente
  wamid        String?
  wa_entregado Boolean   @default(false)
  wa_leido     Boolean   @default(false) // el tío además lo abrió (si tiene los acuses de lectura activos)
  mensaje      String? // el texto tal cual le llegó al tío (sin el PDF)
  wa_intentos  Int       @default(0)
  wa_detalle   String? // motivo cuando no se entregó
  enviado_at   DateTime?
  despachado   Boolean   @default(false)
  avisos_tio   Int       @default(0)
  escalados    Int       @default(0)
  actualizado  DateTime  @updatedAt

  @@index([fecha_compra])
}

/// Espejo en Postgres de las preguntas de MercadoLibre (MICELIUMSTORE) que el
/// autoresponder del VPS clasifica y contesta. Mismo motivo que EnvioApicola: el VPS no
/// es alcanzable desde Vercel, así que empuja su estado en cada ciclo (cron cada 15 min).
model MlPregunta {
  question_id     String    @id // id de la pregunta en la API de ML, clave de idempotencia
  item_id         String?
  item_titulo     String?
  comprador_id    String?
  comprador_nick  String?
  texto           String
  respuesta       String?
  estado          String // pendiente | auto_respondida | pendiente_aprobacion | bloqueada | respondida_manual
  motivo_bloqueo  String?
  intent          String?
  fecha_pregunta  DateTime
  fecha_respuesta DateTime?
  actualizado     DateTime  @updatedAt

  @@index([fecha_pregunta])
  @@index([estado])
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoría del sistema: una corrida completa de chequeos, disparada a mano desde el panel
// o sola una vez por día.
//
// POR QUÉ SE GUARDA EL HISTORIAL Y NO SOLO EL ÚLTIMO RESULTADO
//
// Un chequeo que falla una vez y uno que falla todos los días desde hace un mes piden
// reacciones opuestas, y con solo el estado actual son indistinguibles. El historial
// permite además el diff contra la corrida anterior: "esto empeoró desde ayer" es la
// pregunta que se hace cuando algo se rompió y no se sabe cuándo.
model AuditoriaRun {
  id          String           @id @default(cuid())
  ts          DateTime         @default(now())
  origen      String // manual | programada
  duracion_ms Int?
  total       Int              @default(0)
  ok          Int              @default(0)
  warn        Int              @default(0)
  fail        Int              @default(0)
  checks      AuditoriaCheck[]

  @@index([ts])
}

// Un chequeo dentro de una corrida.
//
// `hint` no es opcional por capricho de diseño: un panel que dice "esto está roto" sin
// decir qué hacer obliga a reconstruir el diagnóstico desde cero cada vez. El patrón viene
// de crm_watchdog.py, que ya guardaba el comando exacto para investigar cada falla.
model AuditoriaCheck {
  id     String       @id @default(cuid())
  run_id String
  run    AuditoriaRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  clave  String // identificador estable: sirve para seguir un chequeo entre corridas
  grupo  String // automatizaciones | credenciales | negocio | infra
  titulo String
  estado String // ok | warn | fail
  valor  String? // lo que se midió
  umbral String? // contra qué se comparó
  hint   String? // cómo se arregla

  @@index([run_id])
  @@index([clave, id])
}
