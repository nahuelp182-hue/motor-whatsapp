# Variables mínimas para una instancia de SOLO widgets + reseñas.
#
# El repo entero usa ~60 variables porque conviven siete productos (bot de WhatsApp,
# MercadoLibre, Meta Ads, CRM, apicultura...). Una instancia que solo sirve widgets
# necesita las de acá abajo: verificado el 28/08/2026 recorriendo el código real de
# app/api/widgets, app/api/resenas, el panel, y las libs que tocan (prisma, session,
# cron-auth, middleware).
#
# Para qué sirve este archivo: dar de alta la instancia de OSA MAYOR (ver OSAMAYOR.md)
# sin arrastrar la configuración de Micelium. Todo lo que NO está acá se puede dejar sin
# definir: los crons de Micelium no se disparan solos (vercel.json tiene "crons": [], los
# llama el VPS) y los webhooks fallan cerrado si les falta el secreto de firma.
#
# NO commitear el archivo con los valores reales: .gitignore cubre .env*, y este ejemplo
# se llama .ejemplo justamente para quedar afuera de esa regla sin traer secretos.

# ─── Base de datos ────────────────────────────────────────────────────────────
# OJO: son DOS caminos distintos y no es un error de configuración, es así a propósito.
#   - El runtime usa DB_HOST/DB_PORT/DB_USER/DB_PASSWORD (pooler, puerto 6543).
#   - Las migraciones usan DATABASE_URL (prisma.config.ts).
# Ver el CLAUDE.md del repo, sección "Base de datos — hay dos caminos y no son el mismo".
DB_HOST=
DB_PORT=6543
DB_USER=
DB_PASSWORD=
# Certificados estrictos. Dejar sin encender hasta probarlo: si la cadena no valida, se
# cae TODA consulta. Se prueba primero en un preview con base propia.
DB_SSL_STRICT=

# Solo para migraciones (npx prisma migrate deploy). Puerto 5432 o conexión directa,
# NO el 6543 del pooler.
DATABASE_URL=

# ─── Tiendanube ───────────────────────────────────────────────────────────────
# El ID de la TIENDA, no el de la app. Para OSA MAYOR es 3224928 (el 32868 es la app:
# usarlo devuelve 401 y parece un problema de token cuando no lo es).
TN_STORE_ID=
# Sale del flujo OAuth cuando la app se instala; no se copia de ningún panel.
# Los access token de tienda son 40 caracteres hex.
TN_ACCESS_TOKEN=

# ─── Panel ────────────────────────────────────────────────────────────────────
# DISTINTA a la de Micelium. Si es la misma, el aislamiento entre instancias es de mentira.
# Sin esto, el middleware devuelve 503 en producción (falla cerrado, a propósito).
DASHBOARD_PASSWORD=

# ─── Crons ────────────────────────────────────────────────────────────────────
# Autoriza las rutas /api/cron. Sin esto responden 503, no quedan abiertas.
# Acá solo hace falta para el cron de reseñas de Google.
CRON_SECRET=

# ─── Reseñas de Google (opcional) ─────────────────────────────────────────────
# Solo si la tienda tiene ficha de Google Business y se quieren traer sus reseñas.
# El refresh token es de LA CUENTA DE ESA TIENDA, no la de Micelium: son cuentas de
# Google distintas, con su propio OAuth. Scope: business.manage.
# Si se dejan vacías, el cron no trae nada y el resto del motor funciona igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REVIEWS_REFRESH_TOKEN=
GOOGLE_REVIEWS_ACCOUNT_ID=
GOOGLE_REVIEWS_LOCATION_ID=

# ─── Almacenamiento de imágenes ───────────────────────────────────────────────
# Fotos de reseñas y medios de los widgets. El SDK de Vercel Blob toma el token del
# entorno solo; en un deploy de Vercel con Blob conectado se inyecta automáticamente.
# Verificar cómo quedó nombrado en el despliegue antes de dar por hecho que está.
# BLOB_READ_WRITE_TOKEN=

# ─── Lo que NO va acá ─────────────────────────────────────────────────────────
# Nada de WHATSAPP_*, WA_*, META_*, ML_*, CHATWOOT_*, TELEGRAM_*, GA4_*, GOOGLE_ADS_*,
# IG_*, FB_*, CLARITY_*, YOUTUBE_*, GMAIL_*, ANDREANI ni MANUAL_*. Todo eso es de
# Micelium. Sin esas variables, esas rutas no se pueden usar — que es justo lo que se
# quiere: ausente es mejor que presente y roto.
